  "stage": "pre-alpha",
  "claims": [
    {
      "id": "drop",
      "kind": "feature",
      "spec": "FR-4.2",
      "ships_with": [
        "WI-013"
      ],
      "text": "Drop a report on the map in a few taps: police line, medic, water, exit open."
    },
    {
      "id": "hop",
      "kind": "feature",
      "spec": "FR-5.1",
      "ships_with": [
        "WI-009",
        "WI-011"
      ],
      "text": "Reports hop from phone to phone nearby, with no server in between."
    },
    {
      "id": "expire",
      "kind": "feature",
      "spec": "FR-7.1",
      "ships_with": [
        "WI-008",
        "WI-009"
      ],
      "text": "Every report has a short lifetime, then every phone drops it."
    },
    {
      "id": "map",
      "kind": "feature",
      "spec": "FR-2.1",
      "ships_with": [
        "WI-012"
      ],
      "text": "Works on an offline map of your area that you get before you go."
    },
    {
      "id": "confirm",
      "kind": "feature",
      "spec": "FR-6.1",
      "ships_with": [
        "WI-019"
      ],
      "text": "Confirm a report is still true, or say it's gone, and see how many nearby phones agree."
    },
    {
      "id": "position",
      "kind": "feature",
      "spec": "FR-10.1",
      "ships_with": [
        "WI-020"
      ],
      "text": "Share your position with your group only, and only while you turn it on."
    },
    {
      "id": "discreet",
      "kind": "feature",
      "spec": "FR-13.1",
      "ships_with": [
        "WI-025"
      ],
      "text": "Discreet mode: darkest screen, no sound, no vibration, neutral notifications."
    },
    {
      "id": "languages",
      "kind": "feature",
      "ships_with": [
        "WI-037"
      ],
      "text": "In English, French and Spanish."
    },
    {
      "id": "review",
      "kind": "feature",
      "ships_with": [
        "WI-030"
      ],
      "text": "An independent security review of the protocol, the cryptography and the code."
    },
    {
      "id": "group-read",
