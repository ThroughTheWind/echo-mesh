    {
      "id": "group-sender",
      "kind": "feature",
      "protects": 2,
      "ships_with": [
        "WI-018"
      ]
    },
    {
      "id": "no-fixed-id",
      "kind": "feature",
      "protects": 3,
      "ships_with": [
        "WI-011",
        "WI-027"
      ]
    },
    {
      "id": "no-history",
      "kind": "feature",
      "protects": 4,
      "ships_with": [
        "WI-009",
        "WI-010"
      ]
    },
    {
      "id": "wipe",
      "kind": "feature",
      "protects": 5,
      "ships_with": [
        "WI-024"
      ]
    },
    {
      "id": "no-server",
      "kind": "design",
      "protects": 6,
      "gate": "privacy"
    },
    {
      "id": "no-trackers",
      "kind": "design",
      "gate": "privacy",
      "text": "No ads, no analytics, no crash reports and no Google Play Services."
    },
    {
      "id": "open",
      "kind": "design",
      "file": "LICENSE",
      "text": "Free and open source under GPL-3.0: anyone can read the code and build it."
    },
    {
      "id": "limit-detectable",
      "kind": "limit",
      "limit": 1
    },
    {
      "id": "limit-fake",
      "kind": "limit",
      "limit": 2
    },
    {
      "id": "limit-members",
      "kind": "limit",
      "limit": 3
    },
    {
      "id": "limit-unlocked",
      "kind": "limit",
      "limit": 4
    },
    {
      "id": "limit-origin",
      "kind": "limit",
      "limit": 5
    },
    {
      "id": "limit-download",
      "kind": "limit",
      "limit": 6
    },
    {
      "id": "never-chat",
      "kind": "never",
      "out_of_scope": "Text chat",
      "text": "Chat. Briar already does messaging without servers; Echo carries reports."
    },
    {
      "id": "never-media",
      "kind": "never",
      "out_of_scope": "Photos, video, voice",
      "text": "Photos, video or voice. They carry faces and metadata that put people at risk."
    },
    {
      "id": "never-bridges",
      "kind": "never",
      "out_of_scope": "Internet or satellite relays, bridges to other networks",
      "text": "Relays over the internet or satellite. A bridge is a place to watch from."
    },
    {
      "id": "never-routes",
      "kind": "never",
      "out_of_scope": "Routing (\"safe way out\")",
      "text": "Suggested routes out. The mesh can't know a street is clear, and a wrong route hurts people."
    },
    {
      "id": "never-ios",
      "kind": "never",
      "out_of_scope": "iOS",
      "text": "iPhone. Apple limits the background radio a mesh depends on."
    }
  ],
