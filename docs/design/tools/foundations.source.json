          "danger-container": "{error-container}",
          "danger-content": "{on-error-container}"
        }
      },
      {
        "name": "snackbar",
        "usage": "Snackbar",
        "tokens": {
          "min-height": "64px",
          "radius": "{radius-md}",
          "container": "{inverse-surface}",
          "content": "{inverse-on-surface}",
          "action": "{inverse-primary}"
        }
      },
      {
        "name": "sheet",
        "usage": "Bottom sheets",
        "tokens": {
          "container": "{surface-container}",
          "radius": "{radius-xl}",
          "scrim": "{scrim}",
          "scrim-opacity": "{scrim-opacity}",
          "shadow": "{elevation-3}"
        }
      },
      {
        "name": "dialog",
