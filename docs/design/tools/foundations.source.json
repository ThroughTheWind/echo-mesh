          "title": "{title-large}"
        }
      },
      {
        "name": "focus",
        "usage": "Focus indicator",
        "tokens": {
          "ring-width": "{focus-ring}",
          "ring-color": "{secondary}"
        }
      },
      {
        "name": "pin",
        "usage": "Report pin",
        "tokens": {
          "size": "{pin-size}",
          "hit": "{touch-min}",
          "halo-width": "{pin-halo-width}",
          "halo": "{pin-halo}",
          "ring-width": "{expiry-ring}",
