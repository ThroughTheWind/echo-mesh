<?xml version="1.0" encoding="utf-8"?>
<!--
  No INTERNET permission, on purpose: the app talks only to other phones over peer-to-peer radio
  (ADR-0003). checkManifestPermissions reads the merged manifest of every variant and fails the
  build if any library adds it. Radio permissions arrive with the transport adapters' manifests
  (the Nearby devices group, NFR-10); the app adds only what its relay service needs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The relay foreground service (FR-3.3) and its one notification, asked in context (FR-1.2). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning a group's join code in person (FR-8.2), asked in context when the user taps Join. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started only from a user's tap with the app visible; never at boot (FR-3.3). -->
        <service
            android:name=".mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
